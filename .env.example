# ClearBed configuration. Copy to .env and adjust.
# All patient rows are synthetic unless you deliberately set DATA_MODE=real.
DATA_MODE=synthetic
ENVIRONMENT=dev
LOG_LEVEL=INFO

# LLM provider: ollama (default, local), bedrock, or groq.
# Groq refuses to run when DATA_MODE is anything other than synthetic.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Boston Medical Center neighborhood. Used as the origin for SNF distance.
HOSPITAL_ZIP=02118

# Demo-grade API auth. Replace outside a demo.
API_KEY=demo-key
API_BASE_URL=http://localhost:8000
UI_ORIGIN=http://localhost:8501

# Assumption used only for the leadership cost estimate. Not a hospital finance figure.
COST_PER_BED_DAY=2500
CENSUS_SIZE=60

# CMS Care Compare "Nursing Home Provider Information" (dataset 4pq5-n9py).
CMS_SNF_URL=https://data.cms.gov/provider-data/api/1/datastore/query/4pq5-n9py/0/download?format=csv
RAG_MIN_SIMILARITY=0.25

SYNTHEA_POPULATION=5000
SYNTHEA_SEED=42
